# Password you type to open this site and to approve an AI connector.
OWNER_PASSWORD=

# Long random string that encrypts saved Gmail keys. At least 16 characters.
# A 32-byte hex or base64 key also works. If you change this later, link Gmail again.
TOKEN_ENC_KEY=

# From Google Cloud → Clients. Use replace-me until you have them, then update and redeploy.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Filled in for you when you add Neon from the Vercel Marketplace.
DATABASE_URL=

# Optional. On Vercel the public site URL is detected. Set this for a custom domain
# or for local development.
# BASE_URL=http://127.0.0.1:43123

# Optional. true also requests gmail.modify and gmail.send, and enables create_draft.
# GMAIL_ENABLE_WRITE=false
